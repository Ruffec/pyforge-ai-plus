# ===== Dependencies（依赖目录：本地必需，不入库） =====
node_modules/
src-tauri/target/

# ===== Local tool caches（本地工具链缓存） =====
.cargo-home/
.local-appdata/
.tauri-tools/
.trae/
.verify-shots/

# ===== Local-only build config（本地构建配置，如镜像源；CI 不依赖） =====
.cargo/config.toml

# ===== Build outputs（编译产物，可再生） =====
dist/
*.tsbuildinfo

# ===== Test & coverage（测试运行产物） =====
coverage/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
playwright/.cache/

# ===== Tauri generated（构建时由 tauri-build 自动再生） =====
src-tauri/gen/

# ===== Docs & design（本地文档与设计产物，不入库） =====
docs/

# ===== Environment & secrets（环境与密钥，严禁入库） =====
.env
.env.*
!.env.example
*.key
src-tauri/updates/

# ===== Generated design artifacts（设计管线生成产物） =====
design/
stats.html

# ===== Logs（运行时日志，任意位置） =====
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== Temporary & backup files（临时与备份文件） =====
*.tmp
*.bak
*.orig
*.rej
*~
**/*.rs.bk

# ===== Package manager state（包管理器本地状态） =====
.npm/
.yarn/cache/
.pnpm-store/

# ===== OS: Windows（系统垃圾文件） =====
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ===== OS: macOS（系统垃圾文件） =====
.DS_Store
.Spotlight-V100
.Trashes
._*

# ===== OS: Linux（系统垃圾文件） =====
*~
.nfs*

# ===== Editor / IDE（编辑器本地配置） =====
.idea/
.vscode/settings.json
*.swp
*.swo
